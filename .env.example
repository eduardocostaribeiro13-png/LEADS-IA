# Copy to .env.local. Never commit credentials.
# Browser connection: public Supabase configuration only.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT

# Server connection. Use the public key: requests use the user's JWT + RLS.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# AI provider migration is pending. No AI credentials are bundled.
